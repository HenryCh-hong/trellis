# Copy to apps/api/.env. Every value below is a default from app/core/config.py.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost:5432/opportunity_agent

# --- App --------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_UNIVERSITY=Stanford University

# --- LLM --------------------------------------------------------------------
# auto: use Claude when a key is present, otherwise the offline rule-based
# provider. The app is fully functional with no key at all.
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Polite fetching --------------------------------------------------------
# Set a real address: it goes in the User-Agent and in OpenAlex's polite pool.
# FETCH_CONTACT_EMAIL=you@stanford.edu
RESPECT_ROBOTS_TXT=true
POLITE_DELAY_SECONDS=1.0
FETCH_TIMEOUT_SECONDS=30

# --- Agent behaviour --------------------------------------------------------
# Recency windows for research scoring. Never hard-coded in the scorer.
RECENCY_WINDOW_MONTHS=24
STRONG_RECENCY_WINDOW_MONTHS=12

# --- Reminders --------------------------------------------------------------
# Defaults for new reminders; each reminder stores its own offsets.
DEFAULT_REMINDER_OFFSETS_DAYS=[7,3,1]
